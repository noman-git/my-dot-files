#!/usr/bin/env python3
"""Normalize ~/.config/hypr/monitors.lua after nwg-displays writes it.

nwg-displays saves monitors at raw canvas coordinates (e.g. 7680x2224),
which hung Hyprland at startup on this machine once the NVIDIA GPU came
back (phantom eDP-2 connector + far-from-origin layout, 2026-07-04).

This script shifts every explicit position so the layout is anchored at
0x0 (the relative arrangement is preserved exactly), backs up the previous
file to monitors.lua.bak and live-reloads Hyprland if it is running.

The catch-all rule for unknown connectors lives in hyprland.lua, because
nwg-displays rewrites monitors.lua from scratch on every save.

Run it after using nwg-displays:  hypr-normalize-monitors [path]
"""

import os
import re
import shutil
import subprocess
import sys

DEFAULT = os.path.expanduser("~/.config/hypr/monitors.lua")
OUTPUT_RE = re.compile(r'^\s*output\s*=\s*"([^"]*)"')
POS_RE = re.compile(r'^(\s*position\s*=\s*")(-?\d+)x(-?\d+)(".*)$')


def main():
    conf = sys.argv[1] if len(sys.argv) > 1 else DEFAULT
    try:
        with open(conf) as f:
            lines = f.read().splitlines()
    except FileNotFoundError:
        sys.exit(f"{conf} not found")

    # Each hl.monitor({...}) block lists output before position. Skip blocks
    # with an empty output (catch-all) and positions that are not "XxY".
    entries = []  # (line_index, regex match, output name, x, y)
    output = None
    for i, line in enumerate(lines):
        m = OUTPUT_RE.match(line)
        if m:
            output = m.group(1)
            continue
        m = POS_RE.match(line)
        if m and output:
            entries.append((i, m, output, int(m.group(2)), int(m.group(3))))

    if not entries:
        print("no explicit positions in monitors.lua, nothing to do")
        return
    min_x = min(e[3] for e in entries)
    min_y = min(e[4] for e in entries)
    if (min_x, min_y) == (0, 0):
        print("monitors.lua already anchored at 0x0, nothing to do")
        return

    for i, m, name, x, y in entries:
        lines[i] = f"{m.group(1)}{x - min_x}x{y - min_y}{m.group(4)}"
        print(f"  {name}: {x}x{y} -> {x - min_x}x{y - min_y}")

    shutil.copy2(conf, conf + ".bak")
    with open(conf, "w") as f:
        f.write("\n".join(lines) + "\n")
    print(f"normalized {conf} (backup: {os.path.basename(conf)}.bak)")

    if conf == DEFAULT and os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        subprocess.run(["hyprctl", "reload"], check=False)


if __name__ == "__main__":
    main()
