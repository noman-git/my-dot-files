; cava config for macOS, written by wallust from the current wallpaper
; (mac-wallpaper). Same gradient as the Arch template
; (hypr-desktop/.config/wallust/templates/colors-cava).

[general]
framerate = 60
bars = 0
bar_width = 2
bar_spacing = 1

[input]
; Core Audio tap: the system output mix without a loopback device
; (macOS 14.2 and later). macOS asks once to let the terminal record audio.
method = coreaudio
source = tap

[output]
method = ncurses

[color]
gradient = 1
gradient_count = 8
gradient_color_1 = '{{color0}}'
gradient_color_2 = '{{color2}}'
gradient_color_3 = '{{color3}}'
gradient_color_4 = '{{color5}}'
gradient_color_5 = '{{color7}}'
gradient_color_6 = '{{color12}}'
gradient_color_7 = '{{color13}}'
gradient_color_8 = '{{color15}}'

[smoothing]
noise_reduction = 77
